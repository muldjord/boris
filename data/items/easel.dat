var stroke = [@64 - 1],
draw sprite paint stroke [6 + (@14 - 1)] [@15 - 1],
draw transparent rectangle 6 0 20 25,
draw transparent rectangle 7 0 18 24

0;50;0;0;;var strokes -= 1,if strokes >= 0 goto nextstroke else goto wait

0;50;0;0;;label wait,var cycles -= 1
0;50;0;0;;
0;50;0;0;;
0;1000;0;0;;if cycles >= 0 goto initstrokes else { if stepbacks >= 0 goto stepback else goto endpaint }

