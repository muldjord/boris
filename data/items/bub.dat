if nextmove = 3 goto bublwest,
if nextmove = 4 goto bubleast,
if nextmove = 5 goto jumpwestup,
if nextmove = 6 goto jumpwestdn,
if nextmove = 7 goto jumpeastup,
if nextmove = 8 goto jumpeastdn

