oneShot
doNotDisturb

define init:if bdir != -1 { if bdir = 0 goto north,
if bdir = 1 goto northeast,
if bdir = 2 goto east,
if bdir = 3 goto southeast,
if bdir = 4 goto south,
if bdir = 5 goto southwest,
if bdir = 6 goto west,
if bdir = 7 goto northwest },
var slubbers = [@3 + 3]

