category=Reaction

oneShot

define init:var sitloop = [@5 + 5],
if idir = -1 var sdir = [@8 - 1] else var sdir = idir,
if sdir = 0 goto north,
if sdir = 1 goto northeast,
if sdir = 2 goto east,
if sdir = 3 goto southeast,
if sdir = 4 goto south,
if sdir = 5 goto southwest,
if sdir = 6 goto west,
if sdir = 7 goto northwest

define wonder:var thought = @4,
if thought = 1 think "Huh?",
if thought = 2 think "What's this?",
if thought = 3 think "Erm..?",
if thought = 4 think "Wut?"

